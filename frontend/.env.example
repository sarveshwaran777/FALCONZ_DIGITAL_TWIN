# Netlify / Production Frontend Environment Variables
# If running with a hosted backend (e.g., on Render, Railway, Fly.io):
# VITE_API_BASE_URL=https://your-backend-service.onrender.com/api
# VITE_WS_BASE_URL=wss://your-backend-service.onrender.com

# Defaults to '/api' and window.location for local development with Vite proxy
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
